# Environment Variables — Tangent
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://tangent:changeme@localhost:5432/tangent
REDIS_URL=redis://localhost:6379/0

# ── Auth (gateway) ────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRY_MINUTES=60
ALLOWED_ORIGINS=http://localhost:3000

# ── LLM ───────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
SECOND_LLM_API_KEY=your_second_llm_key_here
LLM_PRIMARY_MODEL=groq/llama-3.3-70b-versatile
LLM_SECONDARY_MODEL=gemini/gemini-1.5-flash
# live | recorded (use 'recorded' for tests and demo mode)
LLM_MODE=live

# ── News (sentiment service) ──────────────────────────────────────────────────
# Optional: only needed if upgrading from RSS to NewsAPI
NEWS_API_KEY=

# ── Market Data ───────────────────────────────────────────────────────────────
# Optional: backup provider key if yfinance fails
FALLBACK_MARKET_API_KEY=

# ── Quant ─────────────────────────────────────────────────────────────────────
MC_PATHS=10000
MC_SEED=42

# ── Agent ─────────────────────────────────────────────────────────────────────
# Maximum tokens per analysis run (across all agents)
RUN_TOKEN_BUDGET=50000

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Set to 'true' to use fixtures and recorded LLM responses (no external APIs needed)
DEMO_MODE=false

# ── Observability (optional) ──────────────────────────────────────────────────
SENTRY_DSN=

# ── Internal Service URLs (used by gateway and agent in production) ───────────
MARKET_DATA_SERVICE_URL=http://market-data:8001
QUANT_SERVICE_URL=http://quant:8002
SENTIMENT_SERVICE_URL=http://sentiment:8003
AGENT_SERVICE_URL=http://agent:8004
PORTFOLIO_SERVICE_URL=http://portfolio:8005
