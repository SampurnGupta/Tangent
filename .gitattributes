# Force LF line endings for files that run inside Linux containers
# This is critical on Windows to avoid CRLF breaking shell scripts in Docker

*.sh text eol=lf
*.bash text eol=lf
Dockerfile* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env text eol=lf
*.env.example text eol=lf
justfile text eol=lf
Makefile text eol=lf
*.toml text eol=lf
*.lock text eol=lf -diff

# Normalize all text files to LF on commit
* text=auto eol=lf

# Binary files — don't touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.pkl binary
*.whl binary
