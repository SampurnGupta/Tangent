# Tangent Production Environment Configuration Template
APP_ENV=production
DEMO_MODE=false
LOG_LEVEL=INFO
JSON_LOGS=true

# Security
JWT_SECRET=replace-with-a-random-secure-64-character-hex-string
JWT_EXPIRY_MINUTES=1440

# Database (Supabase PostgreSQL Connection Pooler URL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres  # pragma: allowlist secret

# Redis Cache & Session Memory (Upstash Redis)
UPSTASH_REDIS_URL=rediss://default:TOKEN@HOST:6379  # pragma: allowlist secret
REDIS_URL=rediss://default:TOKEN@HOST:6379  # pragma: allowlist secret

# LLM Inference API Keys
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIzaSy...
MISTRAL_API_KEY=...

# Self-Hosted Ollama on Oracle Cloud Always-Free ARM VM (Optional, defaults to Mistral)
OLLAMA_API_BASE=http://YOUR_ORACLE_VM_IP:11434

# Gateway Internal Service Routing (GCP Cloud Run URLs)
MARKET_DATA_URL=https://tangent-market-data-PROJECT_ID.run.app
QUANT_URL=https://tangent-quant-PROJECT_ID.run.app
PORTFOLIO_URL=https://tangent-portfolio-PROJECT_ID.run.app
SENTIMENT_URL=https://tangent-sentiment-PROJECT_ID.run.app
AGENT_URL=https://tangent-agent-PROJECT_ID.run.app

# Render Persona & Observatory Service URLs
PERSONA_MACRO_URL=https://tangent-persona-macro.onrender.com
PERSONA_GROWTH_URL=https://tangent-persona-growth.onrender.com
PERSONA_RISK_URL=https://tangent-persona-risk.onrender.com
OBSERVATORY_URL=https://tangent-observatory.onrender.com

# Public Web Frontend Target Gateway
NEXT_PUBLIC_GATEWAY_URL=https://tangent-gateway-PROJECT_ID.run.app
